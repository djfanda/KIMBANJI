/-
남북 축 — 합동수와 터널 셈 : BSD 의 «정확 셈으로 닫히는 판본» (린 4 코어 · 자연수 셈)

n 이 합동수 = 넓이가 n 인 유리수 직각삼각형이 있음 ⇔ 타원 곡선 Eₙ : y² = x³ − n²x 의 계수가 양수.
터널 (1983) 의 셈 : 제곱 인수 없는 n 에 대해
  홀수 n : A = #{(x, y, z) ∈ ℤ³ : 2x² + y² + 32z² = n} · B = #{2x² + y² + 8z² = n}
  짝수 n : C = #{4x² + y² + 32z² = n/2} · D = #{4x² + y² + 8z² = n/2}
전언 (고전 정리 · 린 밖) : n 이 합동수이면 2A = B (짝수는 2C = D) — 조건 없이 (코츠–와일스 · 터널).
  그러므로 «2A ≠ B» 는 «합동수가 아님» 의 증명서다. 거꾸로 «2A = B ⇒ 합동수» 는 BSD (약한 꼴) 가 있어야 한다.
이 파일이 커널로 확인하는 것 :
  1. n ≤ 200 의 제곱 인수 없는 수 122 개 전부에서 터널 셈 — 등호가 서는 수 73 개 (목록), 서지 않는 수 49 개.
  2. 그 73 개 가운데 42 개는 넓이 n 인 유리 직각삼각형 증명서 (a² + b² = c², ab/2 = n) 를 커널이 정확 산술로 확인 → 조건 없이 합동수.
  3. 증명서가 있는 42 개는 모두 터널 등호를 만족 (터널 정리와의 일치 검사).
  남은 31 개는 «BSD 아래 합동수» 로 남긴다 (다른 방법 — 헤그너 점 등 — 으로 알려진 것도 있으나 우리 커널 증명서는 아직 없음).

저자의 읽기 (수학 주장 아님) : 남북 축 — 바닥의 증명서 (삼각형) 와 위의 셈 (터널) 이 만나는 자리. BSD 자체는 이 파일로 닫히지 않는다.
-/
set_option Elab.async false

namespace Tunnell

def w (x : Nat) : Nat := if x == 0 then 1 else 2

/-- #{(x, y, z) ∈ ℤ³ : a x² + y² + c z² = m} (m ≤ 200 이면 |x|, |y|, |z| ≤ 14) -/
def cnt (a c m : Nat) : Nat :=
  Nat.rec (motive := fun _ => Nat) 0 (fun x s1 =>
    Nat.rec (motive := fun _ => Nat) s1 (fun y s2 =>
      Nat.rec (motive := fun _ => Nat) s2 (fun z s3 =>
        s3 + (if a * x * x + y * y + c * z * z == m then w x * w y * w z else 0)) 15) 15) 15

def sqf (n : Nat) : Bool := (List.range' 2 13).all (fun p => n % (p * p) != 0)

/-- 터널 등호 -/
def tunEq (n : Nat) : Bool :=
  if n % 2 == 1 then 2 * cnt 2 32 n == cnt 2 8 n else 2 * cnt 4 32 (n / 2) == cnt 4 8 (n / 2)

/-! ## 1. 터널 셈 (n ≤ 200) -/

theorem sqf_count : ((List.range' 1 200).filter sqf).length = 122 := by decide +kernel
theorem tunnell_1_50 : (List.range' 1 50).filter (fun n => sqf n && tunEq n) = [5, 6, 7, 13, 14, 15, 21, 22, 23, 29, 30, 31, 34, 37, 38, 39, 41, 46, 47] := by decide +kernel
theorem tunnell_51_100 : (List.range' 51 50).filter (fun n => sqf n && tunEq n) = [53, 55, 61, 62, 65, 69, 70, 71, 77, 78, 79, 85, 86, 87, 93, 94, 95] := by decide +kernel
theorem tunnell_101_150 : (List.range' 101 50).filter (fun n => sqf n && tunEq n) = [101, 102, 103, 109, 110, 111, 118, 119, 127, 133, 134, 137, 138, 141, 142, 143, 145, 149] := by decide +kernel
theorem tunnell_151_200 : (List.range' 151 50).filter (fun n => sqf n && tunEq n) = [151, 154, 157, 158, 159, 161, 165, 166, 167, 173, 174, 181, 182, 183, 190, 191, 194, 197, 199] := by decide +kernel
theorem tunnell_sizes : [5, 6, 7, 13, 14, 15, 21, 22, 23, 29, 30, 31, 34, 37, 38, 39, 41, 46, 47].length + [53, 55, 61, 62, 65, 69, 70, 71, 77, 78, 79, 85, 86, 87, 93, 94, 95].length + [101, 102, 103, 109, 110, 111, 118, 119, 127, 133, 134, 137, 138, 141, 142, 143, 145, 149].length + [151, 154, 157, 158, 159, 161, 165, 166, 167, 173, 174, 181, 182, 183, 190, 191, 194, 197, 199].length = 73 ∧ 122 - 73 = 49 := by decide

/-- 1 · 2 · 3 은 등호가 서지 않음 → 합동수가 아님 (n = 1 은 페르마의 정리와 같음) -/
theorem small_not : tunEq 1 = false ∧ tunEq 2 = false ∧ tunEq 3 = false := by decide +kernel

/-! ## 2. 직각삼각형 증명서 — (n, a 분자, a 분모, b 분자, b 분모, c 분자, c 분모) -/

abbrev Tri := Nat × Nat × Nat × Nat × Nat × Nat × Nat

def ok (t : Tri) : Bool :=
  let (n, p1, q1, p2, q2, p3, q3) := t
  q1 != 0 && q2 != 0 && q3 != 0 &&
  (p1 * q2 * q3) * (p1 * q2 * q3) + (p2 * q1 * q3) * (p2 * q1 * q3) == (p3 * q1 * q2) * (p3 * q1 * q2) &&
  p1 * p2 == 2 * n * q1 * q2

def certs : List Tri := [(5, 3, 2, 20, 3, 41, 6), (6, 3, 1, 4, 1, 5, 1), (7, 35, 12, 24, 5, 337, 60), (13, 323, 30, 780, 323, 106921, 9690), (14, 21, 2, 8, 3, 65, 6), (15, 15, 2, 4, 1, 17, 2), (21, 7, 2, 12, 1, 25, 2), (22, 33, 35, 140, 3, 4901, 105), (30, 5, 1, 12, 1, 13, 1), (31, 8897, 360, 720, 287, 2566561, 103320), (34, 17, 6, 24, 1, 145, 6), (38, 5301, 425, 1700, 279, 1646021, 118575), (39, 5, 2, 156, 5, 313, 10), (41, 123, 20, 40, 3, 881, 60), (46, 253, 42, 168, 11, 7585, 462), (55, 117, 10, 1100, 117, 17561, 1170), (65, 65, 6, 12, 1, 97, 6), (69, 437, 104, 624, 19, 65425, 1976), (70, 15, 1, 28, 3, 53, 3), (71, 30317, 660, 1320, 427, 12974641, 281820), (77, 525, 848, 18656, 75, 15820337, 63600), (78, 45, 1, 52, 15, 677, 15), (85, 77, 6, 1020, 77, 8521, 462), (86, 2193, 91, 364, 51, 116645, 4641), (93, 8029, 190, 1140, 259, 2090761, 49210), (95, 1443, 34, 6460, 1443, 2093801, 49062), (102, 357, 5, 20, 7, 2501, 35), (109, 2077, 210, 45780, 2077, 10537321, 436170), (110, 33, 1, 20, 3, 101, 3), (111, 35, 2, 444, 35, 1513, 70), (119, 1547, 60, 120, 13, 21361, 780), (137, 1377, 280, 76720, 1377, 21565121, 385560), (138, 115, 2, 24, 5, 577, 10), (141, 329, 4, 24, 7, 2305, 28), (145, 21, 2, 580, 21, 1241, 42), (154, 77, 3, 12, 1, 85, 3), (161, 69, 4, 56, 3, 305, 12), (165, 45, 4, 88, 3, 377, 12), (174, 145, 3, 36, 5, 733, 15), (182, 1235, 21, 588, 95, 117973, 1995), (190, 19, 3, 60, 1, 181, 3), (194, 65, 6, 2328, 65, 14593, 390)]

theorem certs_ok : certs.all ok = true := by decide +kernel
theorem certs_count : certs.length = 42 := by decide
/-- 증명서가 있는 수는 모두 터널 등호를 만족 (조건 없는 방향과의 일치) -/
theorem certs_tunnell : certs.all (fun t => sqf t.1 && tunEq t.1) = true := by decide +kernel
/-- 6 = 넓이 (3, 4, 5) · 5 = (3/2, 20/3, 41/6) · 7 = (24/5, 35/12, 337/60) -/
theorem classic : ok (6, 3, 1, 4, 1, 5, 1) = true ∧ ok (5, 3, 2, 20, 3, 41, 6) = true ∧ ok (7, 24, 5, 35, 12, 337, 60) = true := by decide

/-- 대조 : (3, 4, 5) 는 넓이 1 의 증명서가 아님 -/
theorem control : ok (1, 3, 1, 4, 1, 5, 1) = false := by decide

end Tunnell
