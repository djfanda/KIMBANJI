/-
바일 창 √13 (짝 쪽 · 잘린 기저 N = 6) — 공 산술에서 정수 상자를 거쳐 커널 판정까지 (린 4 코어)
창 [−L, L] · L = log √13 · 곱셈 창 [1/√13, √13]. 소수 거듭 2 · 3 · 4 · 5 · 7 · 8 · 9 · 11 (log n < 2L = log 13) 의 소수 항이 모두 들어감.
가운데 정수 행렬 = round(D · G) (D = 2^38 · G 는 바일 꼴의 6 × 6 그람 행렬 · 256 비트 공 산술 · 바깥/창인증/창_작은_√13_N6.json).
공의 반지름 아래에서 |D·g − (가운데)ᵢⱼ| ≤ 1 (= e) — 이 상자 부등식은 파이썬 공 산술의 몫 (린 밖 · 칸마다 정확한 유리수로 검산).
린 커널이 하는 일 : S = (가운데) − (N·e + m)·I (m = 9) 의 정수 인증서 c·S = Σ d ℓ ℓᵀ 를 검사하고,
상자 정리 (box_sound) 로 «상자 안의 모든 정수 행렬 M 에서 M − 9·I 가 양반정치» 를 낸다.
뜻 : 잘린 6 차원 부분공간에서 λ_min(G) ≥ 9 / 2^38 (상자 부등식이 옳다는 전제 위에서).
이 정리는 창 안의 모든 함수가 아니라 잘린 6 차원에 대한 것이다. 리만 가설에 대해 아무것도 주장하지 않는다.
-/
import Trombo.WindowBox
namespace WindowSqrt13
open PSD WindowBox

/-- 가운데 행렬에서 m·I 를 뺀 것 (A₀ − 9·I) -/
def A0 : List (List Int) := [[12460997325, 27066362952, 32827154785, 30682267551, 21366453225, 14212558305], [27066362952, 59168950124, 73144876810, 71447789837, 54449465601, 37863663335], [32827154785, 73144876810, 95477133515, 104414662044, 95995872133, 72430149706], [30682267551, 71447789837, 104414662044, 137761975475, 158271309704, 130294270420], [21366453225, 54449465601, 95995872133, 158271309704, 218909442511, 196959456708], [14212558305, 37863663335, 72430149706, 130294270420, 196959456708, 205691437005]]
def certS : Cert := { n := 6, A := [[12460997319, 27066362952, 32827154785, 30682267551, 21366453225, 14212558305], [27066362952, 59168950118, 73144876810, 71447789837, 54449465601, 37863663335], [32827154785, 73144876810, 95477133509, 104414662044, 95995872133, 72430149706], [30682267551, 71447789837, 104414662044, 137761975469, 158271309704, 130294270420], [21366453225, 54449465601, 95995872133, 158271309704, 218909442505, 196959456708], [14212558305, 37863663335, 72430149706, 130294270420, 196959456708, 205691436999]], c := 1391155748189347646716712646426988483473242972789882179218007245311866904302481744059331308794719923935220946770837596565258152, rows := [(111640803105556598404137145326913980012007333679603866000800256276169968759663589496622642584064255823087297044208408, [12460997319, 27066362952, 32827154785, 30682267551, 21366453225, 14212558305]), (213049305460902168070734454330173123704640295997928273484228238973468018446705939348461799691739644, [0, 1572041779681526446, 7648809245233915690, 19951109293864758817, 33394155630087601173, 29045581915120560835]), (6608044017729120197825368762632948914948016352858923855931402599930673392642992323, [0, 0, 89278623213376924865857496, 507413956973521387265073636, 1393548623742564687917064567, 2276123882198715488488652814]), (87128791078724758600565232965580094438001644891466076088480782114884, [0, 0, 0, 715363164063090351606611270177247, 6012637980084640015191024292935586, 23807199661824857790437640585171961]), (36435365749324437960570253901984149918763169245740873, [0, 0, 0, 0, 6671693104503429057391860294464081826899, 79803372034333714122840864346394879024354]), (9885294074725306776714771391191733254224613699065375129580988657333608341955261697532369987972378194603378986683223206790231245093808, [0, 0, 0, 0, 0, 1])] }

set_option maxRecDepth 100000 in
theorem cert_ok : check certS = true := by decide +kernel

set_option maxRecDepth 100000 in
theorem cert_mat : ∀ i, i < 6 → ∀ j, j < 6 →
    certS.mat i j = ent A0 i j - (if i = j then ((6 : Nat) : Int) * 1 else 0) := by decide +kernel

/-- **창 √13 · 짝 · N = 6** : 가운데 행렬 (A₀ + 9·I) 둘레 ±1 상자 안의 모든 정수 행렬 M 에서 M − 9·I 는 양반정치. -/
theorem box (M : Nat → Nat → Int)
    (hM : ∀ i, i < 6 → ∀ j, j < 6 → iabs (M i j - ent A0 i j) ≤ 1) :
    ∀ x : Nat → Int, 0 ≤ quad 6 M x :=
  box_sound certS cert_ok 6 (ent A0) 1 (by decide) rfl cert_mat M hM

/-- 대조 : 인증서의 c 를 1 만 바꿔도 검사기가 거부 -/
theorem control_tampered : check { certS with c := certS.c + 1 } = false := by decide +kernel

end WindowSqrt13
