/-
바일 창 √2 (짝 쪽 · 잘린 기저 N = 6) — 공 산술에서 정수 상자를 거쳐 커널 판정까지 (린 4 코어)
가운데 정수 행렬 A₀ = round(D · G) (D = 2¹⁵ · G 는 바일 꼴의 6 × 6 그람 행렬 · 256 비트 공 산술)
공의 반지름이 4.3 × 10⁻⁴¹ 이라 |D·g − A₀ᵢⱼ| ≤ 1 (= e) — 이 상자 부등식은 파이썬 공 산술의 몫(린 밖).
린 커널이 하는 일 : S = A₀ − (N·e + m)·I (m = 18) 의 정수 인증서 c·S = Σ d ℓ ℓᵀ 를 검사하고,
상자 정리(box_sound)로 «상자 안의 모든 정수 행렬 M 에서 M − 18·I 가 양반정치» 를 낸다.
뜻 : 잘린 6 차원 부분공간에서 λ_min(G) ≥ 18 / 2¹⁵ ≈ 5.49 × 10⁻⁴ (상자 부등식이 옳다는 전제 위에서).
이 정리는 창 안의 모든 함수가 아니라 잘린 6 차원에 대한 것이다. 리만 가설에 대해 아무것도 주장하지 않는다.
-/
import Trombo.WindowBox
namespace WindowSqrt2
open PSD WindowBox

def A0 : List (List Int) := [[5991, 12465, 4915, 2813, 1876, 1365], [12465, 26774, 15705, 7338, 4577, 3229], [4915, 15705, 46342, 16112, 7795, 5005], [2813, 7338, 16112, 58463, 16238, 7962], [1876, 4577, 7795, 16238, 67281, 16293], [1365, 3229, 5005, 7962, 16293, 74219]]
def certS : Cert := { n := 6, A := [[5985, 12465, 4915, 2813, 1876, 1365], [12465, 26768, 15705, 7338, 4577, 3229], [4915, 15705, 46336, 16112, 7795, 5005], [2813, 7338, 16112, 58457, 16238, 7962], [1876, 4577, 7795, 16238, 67275, 16293], [1365, 3229, 5005, 7962, 16293, 74213]], c := 436687269899777053986827115979463470379647111716510, rows := [(72963620701717135169060503923051540581394671966, [5985, 12465, 4915, 2813, 1876, 1365]), (30588722939260390749007561804538139223979730, [0, 107339, 727310, 196753, 89089, 51352]), (89192855140182019131402320430012010, [0, 0, 5068044401, 3649860565, 1657415711, 1224812010]), (13153449685937461145105949, [0, 0, 0, 1310148272253598, 326708193029106, 144429965142535]), (16319964538768170, [0, 0, 0, 0, 40847066105011415997, 8980247211785126774]), (30466955367284069707144508276460104992522931445869835915, [0, 0, 0, 0, 0, 1])] }

set_option maxRecDepth 100000 in
theorem cert_ok : check certS = true := by decide +kernel

set_option maxRecDepth 100000 in
theorem cert_mat : ∀ i, i < 6 → ∀ j, j < 6 →
    certS.mat i j = ent A0 i j - (if i = j then ((6 : Nat) : Int) * 1 else 0) := by decide +kernel

/-- **창 √2 · 짝 · N = 6** : 가운데 행렬 (A₀ + 18·I) 둘레 ±1 상자 안의 모든 정수 행렬 M 에서 M − 18·I 는 양반정치. -/
theorem window_sqrt2_box (M : Nat → Nat → Int)
    (hM : ∀ i, i < 6 → ∀ j, j < 6 → iabs (M i j - ent A0 i j) ≤ 1) :
    ∀ x : Nat → Int, 0 ≤ quad 6 M x :=
  box_sound certS cert_ok 6 (ent A0) 1 (by decide) rfl cert_mat M hM

end WindowSqrt2
