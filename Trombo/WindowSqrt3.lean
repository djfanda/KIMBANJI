/-
바일 창 √3 (짝 쪽 · 잘린 기저 N = 6) — 공 산술에서 정수 상자를 거쳐 커널 판정까지 (린 4 코어)
창 [−L, L] · L = log √3 · 곱셈 창 [1/√3, √3]. 소수 거듭 2 (log 2 < 2L = log 3) 의 소수 항이 들어감.
가운데 정수 행렬 = round(D · G) (D = 2^26 · G 는 바일 꼴의 6 × 6 그람 행렬 · 256 비트 공 산술 · 바깥/창인증/창_작은_√3_N6.json).
공의 반지름 아래에서 |D·g − (가운데)ᵢⱼ| ≤ 1 (= e) — 이 상자 부등식은 파이썬 공 산술의 몫 (린 밖 · 칸마다 정확한 유리수로 검산).
린 커널이 하는 일 : S = (가운데) − (N·e + m)·I (m = 10) 의 정수 인증서 c·S = Σ d ℓ ℓᵀ 를 검사하고,
상자 정리 (box_sound) 로 «상자 안의 모든 정수 행렬 M 에서 M − 10·I 가 양반정치» 를 낸다.
뜻 : 잘린 6 차원 부분공간에서 λ_min(G) ≥ 10 / 2^26 (상자 부등식이 옳다는 전제 위에서).
이 정리는 창 안의 모든 함수가 아니라 잘린 6 차원에 대한 것이다. 리만 가설에 대해 아무것도 주장하지 않는다.
-/
import Trombo.WindowBox
namespace WindowSqrt3
open PSD WindowBox

/-- 가운데 행렬에서 m·I 를 뺀 것 (A₀ − 10·I) -/
def A0 : List (List Int) := [[8209325, 18040887, 17648794, 160284, 7222213, 1538599], [18040887, 39902961, 39986809, 3063342, 18542045, 1890607], [17648794, 39986809, 47625964, 30519713, 27149350, 191836], [160284, 3063342, 30519713, 104654393, 30600868, 7519220], [7222213, 18542045, 27149350, 30600868, 93269336, 40175447], [1538599, 1890607, 191836, 7519220, 40175447, 131312398]]
def certS : Cert := { n := 6, A := [[8209319, 18040887, 17648794, 160284, 7222213, 1538599], [18040887, 39902955, 39986809, 3063342, 18542045, 1890607], [17648794, 39986809, 47625958, 30519713, 27149350, 191836], [160284, 3063342, 30519713, 104654387, 30600868, 7519220], [7222213, 18542045, 27149350, 30600868, 93269330, 40175447], [1538599, 1890607, 191836, 7519220, 40175447, 131312392]], c := 1763756172044394942382312300152037637068839121813222449893544772719499061706619667229117411204, rows := [(214848049155404357216757236520110576415514992390138871433007387423914098320045751325916, [8209319, 18040887, 17648794, 160284, 7222213, 1538599]), (102187775266931121652517026643915119364155847102821535623025080702627800041, [0, 2102482890876, 9864572632793, 22256286152190, 21922433694424, -12237094730680]), (98620315609756737718314646941384872701400045417693198351459503, [0, 0, 8506280271765366193, 36698842944034565274, -1906181610462449416, 8153306424896721472]), (37745104514688964919994554433411400986000243748716, [0, 0, 0, 5493362091012704748013283, 51913200638160891568447464, 55613366144900664104598780]), (48939331837150923257537144664230759564, [0, 0, 0, 0, 6560580740199010386634369755417, -35986097934103866593610052452346]), (29120038455188414392230134077021975833520330813505377506911931469776301130239235951115323496481288276, [0, 0, 0, 0, 0, 1])] }

set_option maxRecDepth 100000 in
theorem cert_ok : check certS = true := by decide +kernel

set_option maxRecDepth 100000 in
theorem cert_mat : ∀ i, i < 6 → ∀ j, j < 6 →
    certS.mat i j = ent A0 i j - (if i = j then ((6 : Nat) : Int) * 1 else 0) := by decide +kernel

/-- **창 √3 · 짝 · N = 6** : 가운데 행렬 (A₀ + 10·I) 둘레 ±1 상자 안의 모든 정수 행렬 M 에서 M − 10·I 는 양반정치. -/
theorem box (M : Nat → Nat → Int)
    (hM : ∀ i, i < 6 → ∀ j, j < 6 → iabs (M i j - ent A0 i j) ≤ 1) :
    ∀ x : Nat → Int, 0 ≤ quad 6 M x :=
  box_sound certS cert_ok 6 (ent A0) 1 (by decide) rfl cert_mat M hM

/-- 대조 : 인증서의 c 를 1 만 바꿔도 검사기가 거부 -/
theorem control_tampered : check { certS with c := certS.c + 1 } = false := by decide +kernel

end WindowSqrt3
